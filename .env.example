# Copy to .env and fill in. No space after "=".
Client_ID=
Secret_Key=
PAYPAL_BASE_URL=
# mock (default, no API calls) or anthropic
AI_PROVIDER=
# e.g. claude-haiku-5-5 (hosted demo) or claude-opus-5-5
AI_MODEL=
ANTHROPIC_API_KEY=
# Claude cost limits (blank = defaults: 5.00 / 25.00 / 300 / 40)
AI_DAILY_BUDGET_USD=
AI_TOTAL_BUDGET_USD=
AI_DAILY_CALL_LIMIT=
AI_CLIENT_HOURLY_CALL_LIMIT=
# Optional. Local defaults: http://localhost:8000 and http://localhost:5173.
# On Render both default to RENDER_EXTERNAL_URL (set by Render).
APP_BASE_URL=
FRONTEND_URL=
# Optional: SQLite + uploads location (default backend/data; /var/data in Docker)
DATA_DIR=
